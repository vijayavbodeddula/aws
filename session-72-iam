Create a Customer-Managed Policy
--------------------------------
resource "aws_iam_policy" "vijay_policy" {
  name = "vijay-s3-policy"

  policy = jsonencode({
    Version = "2012-10-17"

    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject"]
      Resource = "arn:aws:s3:::my-company-bucket/*"
    }]
  })
}
# Attach the Customer-Managed Policy to the Role  
resource "aws_iam_role_policy_attachment" "vijay_attach" {
  role       = aws_iam_role.vijay_role.name
  policy_arn = aws_iam_policy.vijay_policy.arn
}